# --- Database (required) -------------------------------------------------------
# PostgreSQL connection string (the schema uses the "postgresql" provider).
# Recommended: Neon (https://neon.tech). Use the pooled connection string.
# For local development, point this at a separate Neon *branch* or a local Postgres,
# NOT your production database, so testing never touches live data.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- AI assistant (optional) ---------------------------------------------------
# Google Gemini key for enhanced classification and chat. The app works without it.
GEMINI_API_KEY=""
